#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// tap windows for ctl alt and gui
#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift
#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70

// レイヤーインデックスの定義
#define BASE   0
#define L1     1
#define L2     2
#define L3     3
#define L4     4
#define L5     5
#define L6     6
#define L7     7
#define L8     8
#define L9     9

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1

// 重複定義エラーを防ぐための処理
#ifdef ZMK_POINTING_DEFAULT_SCRL_VAL
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#endif
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

/ {
    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        // TD0: セミコロン / クォート
        td_semi: tap_dance_semi {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&kp SEMI>, <&kp SQT>;
        };

        // TD1: 単押しスペース / ホールドでLayer 1 / 2回押しでLayer 1トグル
        td_space: tap_dance_space {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&lt 1 SPACE>, <&tog 1>;
        };

        // TD2: 単押し「英数(LANG2)」 / ホールドでLayer 2
        td_lang1: tap_dance_lang1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&lt 2 INT2>, <&kp INT2>;
        };

        // TD3: 単押し「かな(LANG1)」 / ホールドでLayer 3
        td_lang2: tap_dance_lang2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&lt 3 INT1>, <&kp INT1>;
        };

        // TD5: ホールドでLayer 5 / 2回押しでLayer 5トグル
        td_layer5: tap_dance_l5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&mo 5>, <&tog 5>;
        };

        // TD7: 単押しスペース / ホールドでLayer 7 / 2回押しでLayer 7トグル
        td_space_l7: tap_dance_space_l7 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&lt 7 SPACE>, <&tog 7>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Q + W ➔ F2
        combo_f2 {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp F2>;
        };

        // W + E ➔ F3
        combo_f3 {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp F3>;
        };

        // E + R ➔ F4
        combo_f4 {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp F4>;
        };

        // R + T ➔ F5
        combo_f5 {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp F5>;
        };

        // D + F ➔ # (JIS/USに応じたShift+3)
        combo_hash {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LS(N3)>;
        };

        // F + G ➔ ( (Shift+8)
        combo_lparen {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LS(N8)>;
        };

        // H + J ➔ ) (Shift+9)
        combo_rparen {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp LS(N9)>;
        };

        // J + K ➔ [
        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp LBKT>;
        };

        // K + L ➔ -
        combo_minus {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp MINUS>;
        };

        // L + ; ➔ '
        combo_quote {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp SQT>;
        };

        // V + B ➔ ]
        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp RBKT>;
        };

        // N + M ➔ \ (NONUS_HASH / RO)
        combo_backslash {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&kp BSLH>;
        };

        // COMMA + DOT ➔ \_ろ (INT1)
        combo_ro {
            timeout-ms = <50>;
            key-positions = <34 35>;
            bindings = <&kp INT1>;
        };

        // P + O ➔ =
        combo_equal {
            timeout-ms = <50>;
            key-positions = <9 10>;
            bindings = <&kp EQUAL>;
        };

        // BSPC + P ➔ ¥ (INT3)
        combo_yen {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp INT3>;
        };

        // GRAVE + TAB ➔ ESC
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 12>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp Q          &kp W         &kp E         &kp R                &kp T                      &kp Y      &kp U                &kp I            &kp O         &kp P             &kp BSPC
&kp TAB    &hm_l LCTRL A  &hm_l LALT S  &hm_l LGUI D  &hm_shift_l LSHFT F  &kp G                      &kp H      &hm_shift_r RSHFT J  &hm_r RGUI K     &hm_r RALT L  &hm_r RCTRL SEMI  &kp RET
&kp LSHFT  &kp Z          &kp X         &kp C         &kp V                &kp B      &none  &none    &kp N      &kp M                &kp COMMA        &kp DOT       &mt RSHFT FSLH    &kp UP
&kp LCTRL  &kp LGUI       &kp LALT      &td_lang2     &td_space            &td_layer5                 &td_lang1  &td_space_l7         &td_lang2        &kp LEFT      &kp RIGHT         &kp DOWN
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_1 {
            display-name = "Layer 1";
            bindings = <
&trans  &kp SLCK   &kp HOME  &kp UP    &kp END    &kp PG_UP                &kp LS(N1)  &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp LS(N3)   &trans
&trans  &kp LSHFT  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN                &kp LS(N2)  &mt RSHFT KP_N4  &mt RCTRL KP_N5  &mt RALT KP_N6   &kp LS(SQT)  &trans
&trans  &kp LCTRL  &kp F2    &kp DEL   &kp RET    &kp BSPC   &trans  &to 0 &kp KP_N0   &kp KP_N1        &kp KP_N2        &kp KP_N3        &trans       &trans
&trans  &trans     &trans    &mkp MB1  &trans     &mo 5                    &mo 5       &trans           &mkp MB1         &none            &none        &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_2 {
            display-name = "Layer 2";
            bindings = <
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans                  &trans    &kp HOME  &kp UP    &kp END    &trans  &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &trans                  &mkp MB1  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp FSLH  &trans  &to 0 &trans    &trans    &trans    &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &trans    &trans    &none      &none   &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_3 {
            display-name = "Layer 3";
            bindings = <
&trans  &trans  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP                  &none     &kp F9    &kp F10   &kp F11   &kp F12   &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB1                      &none     &kp F5    &kp F6    &kp F7    &kp F8    &trans
&trans  &trans  &trans          &msc SCRL_UP    &msc SCRL_DOWN   &mkp MB2      &trans  &trans  &none     &kp F1    &kp F2    &kp F3    &kp F4    &trans
&trans  &trans  &trans          &mkp MB3        &mkp MB1         &mkp MB2                      &mkp MB2  &mkp MB1  &mkp MB3  &none     &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_4 {
            display-name = "Layer 4";
            bindings = <
&trans  &trans  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP                    &trans    &mt LSHFT INT3  &msc SCRL_UP    &trans           &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                  &to 0     &trans          &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &none           &none           &none            &mkp MB3        &kp MUTE &none  &none     &none           &none           &none            &trans  &kp UP
&trans  &trans  &trans          &trans          &mkp MB1         &mkp MB2                        &mkp MB2  &mkp MB1        &trans          &none            &none   &none
            >;
        };

        layer_5 {
            display-name = "Layer 5";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &trans
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &none   &none    &none
            >;
        };

        layer_6 {
            display-name = "Layer 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &trans    &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                  &kp N6  &kp N7  &kp N8    &kp N9    &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &kp PSCRN &trans &to 0  &trans  &kp NUHS  &kp RBKT  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &none     &none   &none
            >;
        };

        layer_7 {
            display-name = "Layer 7";
            bindings = <
&trans  &trans  &trans    &kp UP    &trans     &kp INS                  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &trans
&trans  &none   &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL                  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &kp PSCRN &trans &trans  &trans    &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans    &mkp MB1  &trans     &trans                   &trans    &trans     &trans     &none      &none   &none
            >;
        };

        layer_8 {
            display-name = "Layer 8";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans   &trans   &trans  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7  &kp F8   &kp F9   &kp F10 &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F11 &kp F12  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans   &none    &none   &none
            >;
        };

        layer_9 {
            display-name = "Layer 9";
            bindings = <
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &kp MUTE &to 0 &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
