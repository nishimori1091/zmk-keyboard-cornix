#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift

#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        // Positional Homerow mods for shift
        // Use faster tapping term and disable some features that may
        // cause false negatives.

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            //flavor = "balanced";

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;

            // for quick tapping; shift+~

            hold-trigger-on-release;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        // TD0: 単押しセミコロン / 2回押しクォート
        td_semi: tap_dance_semi {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&kp SEMI>, <&kp SQT>;
        };

        // TD1: 単押しスペース / ホールドでLayer 1 / 2回押しでLayer 1トグル
        td_space: tap_dance_space {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&lt 1 SPACE>, <&tog 1>;
        };

        // TD2: 単押し「英数(LANG2)」 / ホールドでLayer 2
        td_lang1: tap_dance_lang1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&lt 2 INT2>, <&kp INT2>;
        };

        // TD3: 単押し「かな(LANG1)」 / ホールドでLayer 3
        td_lang2: tap_dance_lang2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&lt 3 INT1>, <&kp INT1>;
        };

        // TD5: ホールドでLayer 5 / 2回押しでLayer 5トグル
        td_layer5: tap_dance_l5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&mo 5>, <&tog 5>;
        };

        // TD7: 単押しスペース / ホールドでLayer 7 / 2回押しでLayer 7トグル
        td_space_l7: tap_dance_space_l7 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&lt 7 SPACE>, <&tog 7>;
        };


    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <3 2>;
            then-layer = <4>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Q + W ➔ F2
        combo_f2 {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp F2>;
        };

        // W + E ➔ F3
        combo_f3 {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp F3>;
        };

        // E + R ➔ F4
        combo_f4 {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp F4>;
        };

        // R + T ➔ F5
        combo_f5 {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp F5>;
        };

        // D + F ➔ # (JIS/USに応じたShift+3)
        combo_hash {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LS(N3)>;
        };

        // F + G ➔ ( (Shift+8)
        combo_lparen {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LS(N8)>;
        };

        // H + J ➔ ) (Shift+9)
        combo_rparen {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp LS(N9)>;
        };

        // J + K ➔ [
        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp LBKT>;
        };

        // K + L ➔ -
        combo_minus {
            timeout-ms = <50>;
            key-positions = <24 25>;
            bindings = <&kp MINUS>;
        };

        // L + ; ➔ '
        combo_quote {
            timeout-ms = <50>;
            key-positions = <25 26>;
            bindings = <&kp SQT>;
        };

        // V + B ➔ ]
        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp RBKT>;
        };

        // N + M ➔ \ (NONUS_HASH / RO)
        combo_backslash {
            timeout-ms = <50>;
            key-positions = <35 36>;
            bindings = <&kp BSLH>;
        };

        // COMMA + DOT ➔ \_ろ (INT1)
        combo_ro {
            timeout-ms = <50>;
            key-positions = <36 37>;
            bindings = <&kp INT1>;
        };

        // P + O ➔ =
        combo_equal {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp EQUAL>;
        };

        // BSPC + P ➔ ¥ (INT3)
        combo_yen {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp INT3>;
        };

        // GRAVE + TAB ➔ ESC
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 7>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp GRAVE &kp Q     &kp W     &kp E     &kp R     &kp T                         &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                &kp TAB   &kp A     &kp S     &kp D     &kp F     &kp G                         &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp RET
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &lt 9 MUTE          &to 0     &kp N     &kp M     &kp COMMA &kp DOT   &mt RSHFT FSLH &kp UP
                &kp LCTRL &kp LGUI  &kp LALT  &td_lang2 &td_space &td_layer5                    &td_lang1 &td_space_l7 &td_lang2 &none    &none     &kp DOWN  &kp RIGHT &kp LEFT
            >;
        };

        layer_1 {
            bindings = <
                &trans    &kp SLCK  &kp HOME  &kp UP    &kp END   &kp PG_UP                     &kp LS(N1) &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp LS(N3) &trans
                &trans    &kp LSHFT &kp LEFT  &kp DOWN  &kp RIGHT &kp PG_DN                     &kp LS(N2) &mt RSHFT KP_N4 &mt RCTRL KP_N5 &mt RALT KP_N6 &kp LS(SQT) &trans
                &trans    &kp LCTRL &kp F2    &kp DEL   &kp RET   &kp BSPC  &trans              &to 0     &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N3 &trans    &trans
                &trans    &trans    &trans    &mkp MB1  &trans    &mo 5                         &mo 5     &trans    &mkp MB1  &none     &none     &trans    &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
                &trans    &trans    &kp N7    &kp N8    &kp N9    &trans                        &trans    &kp HOME  &kp UP    &kp END   &trans    &trans
                &trans    &trans    &kp N4    &kp N5    &kp N6    &trans                        &mkp MB1  &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
                &trans    &kp N0    &kp N1    &kp N2    &kp N3    &kp FSLH  &trans              &to 0     &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &none     &none     &trans    &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
                &trans    &trans    &msc SCRL_LEFT &mmv MOVE_UP &msc SCRL_RIGHT &msc SCRL_UP    &none     &kp F9    &kp F10   &kp F11   &kp F12   &trans
                &trans    &trans    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp MB1      &none     &kp F5    &kp F6    &kp F7    &kp F8    &trans
                &trans    &trans    &trans    &msc SCRL_UP &msc SCRL_DOWN &mkp MB2 &trans         &trans    &none     &kp F1    &kp F2    &kp F3    &kp F4    &trans
                &trans    &trans    &trans    &mkp MB3  &mkp MB1  &mkp MB2                      &mkp MB2  &mkp MB1  &mkp MB3  &none     &none     &trans    &trans    &trans
            >;
        };

        layer_4 {
            bindings = <
                &trans    &trans    &msc SCRL_LEFT &mmv MOVE_UP &msc SCRL_RIGHT &msc SCRL_UP    &trans    &mt LSHFT INT3 &msc SCRL_UP &trans    &trans    &trans
                &trans    &trans    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN &to 0    &trans    &msc SCRL_DOWN &msc SCRL_RIGHT &trans &trans
                &trans    &trans    &none     &none     &none     &mkp MB3  &kp MUTE            &trans    &trans    &none     &none     &none     &trans    &kp UP
                &trans    &trans    &trans    &trans    &mkp MB1  &mkp MB2                      &mkp MB2  &mkp MB1  &trans    &none     &none     &kp RIGHT &kp DOWN  &kp LEFT
            >;
        };

        layer_5 {
            bindings = <
                &trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                        &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &trans
                &trans    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans
                &trans    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans              &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &none     &none     &trans    &trans    &trans
            >;
        };

        layer_6 {
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans
                &trans    &trans    &trans    &trans    &trans    &kp PSCRN &trans              &to 0     &trans    &kp NUHS  &kp RBKT  &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &none     &none     &trans    &trans    &trans
            >;
        };

        layer_7 {
            bindings = <
                &trans    &trans    &trans    &kp UP    &trans    &kp INS                       &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans    &trans
                &trans    &none     &kp LEFT  &kp DOWN  &kp RIGHT &kp DEL                       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &kp PSCRN &trans              &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &mkp MB1  &trans    &trans                        &trans    &trans    &trans    &none     &none     &trans    &trans    &trans
            >;
        };

        layer_8 {
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                        &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans              &trans    &trans    &kp F11   &kp F12   &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &none     &none     &trans    &trans    &trans
            >;
        };

        layer_9 {
            bindings = <
                &none     &none     &none     &none     &none     &none                         &none     &none     &none     &none     &none     &none
                &none     &none     &none     &none     &none     &none                         &none     &none     &none     &none     &none     &none
                &none     &none     &none     &none     &none     &none     &kp MUTE            &to 0     &none     &none     &none     &none     &none     &none
                &none     &none     &none     &none     &none     &none                         &none     &none     &none     &none     &none     &none     &none     &none
            >;
        };
    };
};
